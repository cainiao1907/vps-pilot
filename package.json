{
  "name": "vps-pilot",
  "version": "0.1.0",
  "description": "VPS Pilot - 本地 AI Agent 驱动的 VPS 远程运维客户端",
  "main": "dist-electron/main/index.js",
  "author": "cainiao1907",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cainiao1907/vps-pilot.git"
  },
  "homepage": "https://github.com/cainiao1907/vps-pilot#readme",
  "bugs": {
    "url": "https://github.com/cainiao1907/vps-pilot/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:risk": "node --experimental-strip-types scripts/test-risk.ts",
    "test:proxy": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/test-proxy.ts",
    "test:registry": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/test-registry.ts",
    "test:ui": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/test-ui.tsx",
    "test:events": "node --experimental-strip-types scripts/test-dom-events.ts",
    "test:mcp": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/test-mcp.ts",
    "test:all": "npm run typecheck && npm run test:risk && npm run test:proxy && npm run test:registry && npm run test:events && npm run test:ui && npm run test:mcp",
    "check:host": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-host.ts",
    "e2e": "electron scripts/e2e-test.js",
    "mcp:live": "electron scripts/mcp-live-test.js",
    "mcp:demo": "electron scripts/mcp-demo.js",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "make:launchers": "python scripts/make-launchers.py",
    "clean:debug": "python scripts/clean-debug-dirs.py",
    "mcp:stdio-test": "electron scripts/mcp-stdio-e2e.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ssh2": "^1.16.0"
  },
  "//overrides": "ssh2 把 cpu-features 列为可选依赖，仅用于加速加密计算。它会引入 node-gyp 原生编译，在未安装 Visual Studio 构建工具的机器上会导致 npm install 与打包双双失败。ssh2 找不到它时会自动回退到纯 JS 实现，功能完全一致。这里把它替换成不包含任何原生代码的空包，从源头消除编译需求。",
  "overrides": {
    "cpu-features": "npm:empty-npm-package@1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  }
}