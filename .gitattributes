# 统一换行符与文本处理
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.node binary
*.woff binary
*.woff2 binary

# 语言统计：把生成物排除在 GitHub Linguist 之外
package-lock.json linguist-generated=true
dist/** linguist-generated=true
